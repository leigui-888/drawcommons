#
# 装到裸仓 hooks/post-receive（/opt/drawcommons/git/drawcommons.git/hooks/）。
# 六件事，每件都是为了防一类已经踩过的错：
#   1. update-server-info —— 哑协议只认 info/refs 与 objects/info/packs 两个静态
#      文件，不刷它，clone 拿到的是上一次推送的状态（静默的旧代码）。
#   2. 验签闸门 —— 签名若只在"事后被人查"，就等于没有：查的人少，改的人多。
#      故把验签放在出包之前：签名验不过的 tag，不出包、不进 latest。
#   3. 为每个新 tag 出复现包 —— 「tag 指向 A、包还是 B」时，邀请函指向旧代码。
#      出包这步不能靠人手记得做。
#   4. 同步 latest 别名 —— 页面链的是 /download/drawcommons-latest.tar.gz，写死版本号会导致
#      每打一个 tag 就要改页面，漏改一次就指向旧包。
#   5. 同步名录与公钥 —— 署名承诺与验签公钥都必须能被不装 git 的人读到；
#      它们只活在裸仓对象库里，对浏览器就是不存在。这里摊到 /download/。
#   6. 应用层部署 —— 镜像构建时才 COPY app.py，钩子若不碰它，「仓库改了页面、
#      线上还是旧代码」可以静默很久（2026-11-12 实测四小时未上线）。字节真变了才重建。
#      2026-11-15 起页面文案在 repo/deploy/app/content/：那部分**只同步文件、
#      不重建**（app 按 mtime 热加载），改一句文案不再连带重启写库的 ingest。
# 有 github remote 时顺带镜像；失败只记日志，不让镜像问题回滚本地推送。

set -e

# 日志不能成为单点故障：`logger` 在某些环境（容器、Git Bash）里不存在，而
# 挂钩里好几处日志写在「本来就该继续」的路径上。少了 `2>/dev/null || :`，
# 缺一条日志就会因 set -e 中断整个钩子——比不记日志糟得多，因为它连包都不出了。
log() {
    /usr/bin/logger -t drawcommons-hook "$*" 2>/dev/null || :
}

DL=${DRAWCOMMONS_DOWNLOAD_DIR:-/opt/drawcommons/git/download}
mkdir -p "$DL"

git update-server-info

# 裸仓的 HEAD 未必指向 main（`git init --bare` 默认 master）。只认 HEAD 会在
# "仓库建好了但 HEAD 没改"时静默取不到文件，故 HEAD 取不到就退回 main。
head_file() {
    git show "HEAD:$1" 2>/dev/null || git show "refs/heads/main:$1" 2>/dev/null
}

# 公钥从树里取：裸仓没有工作树，allowed_signers 只在对象库里。
AS=$(mktemp "${TMPDIR:-/tmp}/dc-allowed.XXXXXX")
trap 'rm -f "$AS"' EXIT
if head_file repo/allowed_signers > "$AS" && [ -s "$AS" ]; then
    HAVE_AS=1
else
    HAVE_AS=0
    log "allowed_signers missing in HEAD — 所有 tag 将被拒"
fi

# 验签失败即拒。注意三种失败都要落到 exit 非 0：
#   密码学不符、principal 不在名单（No principal matched）、根本没有签名。
verify_tag() {
    [ "$HAVE_AS" = 1 ] || return 1
    git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$AS" verify-tag "$1" > /dev/null 2>&1
}

while read -r old new ref; do
    case "$ref" in
        refs/tags/v*)
            # 删除 tag 时 new 是 40 个 0，此时 tag 已不存在，git archive 会
            # 报 "not a valid object name" 并被 set -e 中断（连带跳过镜像推送）。
            # 移动 tag（先删后建）的第一跳就走这条，必须放过。
            case "$new" in
                *[!0]*) ;;
                *) continue ;;
            esac
            tag=${ref#refs/tags/}

            if ! verify_tag "$tag"; then
                log "REFUSED $tag: 签名验不过，未出包"
                echo "drawcommons: 拒绝 $tag —— 签名验不过（未签名 / 密钥不符 / principal 不在 allowed_signers）" >&2
                echo "drawcommons: 本地 tag 已推送，但不提供下载包。修法：git tag -s 重签后重推（需先删远端同名 tag）。" >&2
                continue
            fi

            pkg="drawcommons-$tag.tar.gz"
            git archive --format=tar --prefix="drawcommons-$tag/" "$tag" | gzip -9 > "$DL/$pkg"
            (
                cd "$DL"
                sha256sum "$pkg" > "$pkg.sha256"
                # latest 用独立重算的校验值：直接复制版本化的 .sha256 会让
                # `sha256sum -c` 报「找不到 drawcommons-vX.tar.gz」而失败。
                cp -f "$pkg" drawcommons-latest.tar.gz
                sha256sum drawcommons-latest.tar.gz > drawcommons-latest.tar.gz.sha256
            )
            log "packaged $tag (signature ok)"
            ;;
    esac
done

# 5. 名录与公钥摊到下载目录：这两样要能被不装 git 的人读到。
#    从 HEAD 取而不是从某个 tag 取——名录是"当下有效"的记录，历史快照留在各自 tag 里，
#    那正是 CREDITS.md §8 用来防抹除的东西（旧 tag 里的旧哈希改不掉）。
#    公钥同理：验签要用"现在有效"的名单，旧名单在旧 tag 里仍可复现。
for f in repo/CREDITS.md repo/credits.json repo/REVIEWS.md repo/reviews.json repo/allowed_signers; do
    out=${f##*/}
    if head_file "$f" > "$DL/$out.tmp" && [ -s "$DL/$out.tmp" ]; then
        mv -f "$DL/$out.tmp" "$DL/$out"
    else
        rm -f "$DL/$out.tmp"
        log "credits sync skipped: $f not in HEAD"
    fi
done

# 6. 应用层部署。2026-11-12 发现的口子：镜像构建时才 COPY app.py，钩子原先不碰它，
#    于是「仓库里改了页面 → 线上还是几个月前的代码」可以静默很久。当天实测：首页改完
#    四小时未上线，靠比对字节数才发现。
#    只在该文件真的变了才重建（cmp 比字节），避免每次推送都白跑一次 build。
#    2026-11-12 夜补：Dockerfile 与 compose.yml 也一并同步。原先只推 app.py 与
#    ledger_hash.py，于是「改了 Dockerfile（非 root 的 uid）」或「改了 compose
#    （新增卷、环境变量）」在线上永远不生效，而日志一切正常。
APP_DIR=${DRAWCOMMONS_APP_DIR:-/opt/drawcommons/app}
COMPOSE_FILE=${DRAWCOMMONS_COMPOSE:-/opt/drawcommons/compose.yml}
if [ -d "$APP_DIR" ] && command -v docker >/dev/null 2>&1; then
    app_changed=0
    # r6 起同一个 build context 出两个镜像：app（只读）与 ingest（写入面）。
    # 少同步一个文件的后果是「仓库里改了、线上构建用的还是旧的」，而日志一切正常
    # ——这正是 2026-11-12 那次四小时未上线的原因，所以按 context 全量列。
    for f in app.py ledger_hash.py ledger_store.py legal.py Dockerfile \
             ingest.py signing.py Dockerfile.ingest agent.md audit.md; do
        if head_file "repo/deploy/app/$f" > "$APP_DIR/$f.new" 2>/dev/null && [ -s "$APP_DIR/$f.new" ]; then
            if cmp -s "$APP_DIR/$f.new" "$APP_DIR/$f"; then
                rm -f "$APP_DIR/$f.new"
            else
                mv -f "$APP_DIR/$f.new" "$APP_DIR/$f"
                app_changed=1
            fi
        else
            rm -f "$APP_DIR/$f.new"
        fi
    done
    # compose.yml 在部署根目录（与 app/ 同级），里面有卷、环境变量与端口。
    if [ -f "$COMPOSE_FILE" ]; then
        if head_file "repo/deploy/compose.yml" > "$COMPOSE_FILE.new" 2>/dev/null && [ -s "$COMPOSE_FILE.new" ]; then
            if cmp -s "$COMPOSE_FILE.new" "$COMPOSE_FILE"; then
                rm -f "$COMPOSE_FILE.new"
            else
                mv -f "$COMPOSE_FILE.new" "$COMPOSE_FILE"
                app_changed=1
            fi
        else
            rm -f "$COMPOSE_FILE.new"
        fi
    fi
    # 页面文案目录（2026-11-15 起）。文案与代码**分开走**：文案是从挂载目录
    # 热加载的，同步文件即生效，所以这里**不置 app_changed**——改一句文案不该
    # 把写库的 ingest 一起重启，这正是这次改造要消掉的成本。
    # 反过来，漏掉这一段会让「仓库改了文案、线上还是旧的」，与 11-12 那次
    # 四小时未上线是同一类错，故与 app.py 同段维护。
    CONTENT_FILES=$(git ls-tree -r --name-only HEAD -- repo/deploy/app/content/ 2>/dev/null \
                    | sed -n 's|^repo/deploy/app/content/||p')
    mkdir -p "$APP_DIR/content"
    content_changed=0
    for rel in $CONTENT_FILES; do
        mkdir -p "$APP_DIR/content/$(dirname "$rel")"
        if head_file "repo/deploy/app/content/$rel" > "$APP_DIR/content/$rel.new" 2>/dev/null \
           && [ -s "$APP_DIR/content/$rel.new" ]; then
            if cmp -s "$APP_DIR/content/$rel.new" "$APP_DIR/content/$rel"; then
                rm -f "$APP_DIR/content/$rel.new"
            else
                mv -f "$APP_DIR/content/$rel.new" "$APP_DIR/content/$rel"
                content_changed=1
            fi
        else
            rm -f "$APP_DIR/content/$rel.new"
        fi
    done
    # 仓库里删掉的文案页，服务器上也要删——否则线上留着一页没人认领的旧文案。
    #
    # 匹配必须按**整行**：CONTENT_FILES 是换行分隔的，若写成 `case " $CONTENT_FILES "`
    # 再配 `*" $rel "*`，两头补的空格与条目间的换行对不上，**每一项都会被判成
    # 「不在清单里」**，于是每次推送都把服务器上的文案全删掉。2026-11-15 演练时真的
    # 这么删过一次（四个页齐删，站点 500 约一分钟），故改用 grep -qxF 整行精确匹配。
    # 清单为空（目录被移走、ls-tree 失败）时一律不删：宁可留一页旧文案，不可误删全站。
    if [ -n "$CONTENT_FILES" ]; then
        find "$APP_DIR/content" -type f -name '*.html' 2>/dev/null | while read -r f; do
            rel=${f#"$APP_DIR/content/"}
            printf '%s\n' "$CONTENT_FILES" | grep -qxF "$rel" \
                || { rm -f "$f"; log "content removed: $rel"; }
        done
    else
        log "content list empty — 跳过删页（防误删）"
    fi
    if [ "$content_changed" = 1 ]; then
        log "content synced (app 热加载，未重建)"
    fi
    # 人类页面（2026-11-17 起）：repo/deploy/site/ 的 15 个自包含 HTML 落到
    # caddy 的只读挂载点。与 content 同理——同步文件即生效，不重建、不重启。
    # 区别只在挂给谁：content 挂给 app（按 mtime 热加载），site 挂给 caddy（每次请求直读）。
    # 这段漏掉的后果与 content 那次一样：「仓库改了页、线上还是旧的」，而日志一切正常。
    SITE_DIR=${DRAWCOMMONS_SITE_DIR:-/opt/drawcommons/site}
    SITE_FILES=$(git ls-tree -r --name-only HEAD -- repo/deploy/site/ 2>/dev/null \
                 | sed -n 's|^repo/deploy/site/||p')
    mkdir -p "$SITE_DIR"
    site_changed=0
    for rel in $SITE_FILES; do
        mkdir -p "$SITE_DIR/$(dirname "$rel")"
        if head_file "repo/deploy/site/$rel" > "$SITE_DIR/$rel.new" 2>/dev/null \
           && [ -s "$SITE_DIR/$rel.new" ]; then
            if cmp -s "$SITE_DIR/$rel.new" "$SITE_DIR/$rel"; then
                rm -f "$SITE_DIR/$rel.new"
            else
                mv -f "$SITE_DIR/$rel.new" "$SITE_DIR/$rel"
                site_changed=1
            fi
        else
            rm -f "$SITE_DIR/$rel.new"
        fi
    done
    # 仓库里已经删掉的页，服务器上也要删：静态目录没有「插槽没填就报错」那种自检，
    # 多留一页就是多一个旧口径的入口，而且不会有人喊。清单一律非空才删（防误删全站）。
    if [ -n "$SITE_FILES" ]; then
        find "$SITE_DIR" -type f -name '*.html' 2>/dev/null | while read -r f; do
            rel=${f#"$SITE_DIR/"}
            printf '%s\n' "$SITE_FILES" | grep -qxF "$rel" \
                || { rm -f "$f"; log "site removed: $rel"; }
        done
    else
        log "site list empty — 跳过删页（防误删）"
    fi
    if [ "$site_changed" = 1 ]; then
        log "site synced (caddy 直读，未重建)"
    fi
    if [ "$app_changed" = 1 ]; then
        # 重建失败只记日志、让推送照常成功：站点旧代码比"推不上去"好排查，
        # 且回滚推送不是这里该做的事（违反不可改写）。
        # 两个服务一起重建：ledger_store.py 是两个镜像共用的，只重建 app 会让
        # 写入面继续跑旧模块——而它照样 healthy。
        ( cd "$(dirname "$COMPOSE_FILE")" && docker compose -f "$COMPOSE_FILE" up -d --build app ingest ) \
            > /dev/null 2>&1 || log "app/ingest rebuild FAILED — 线上仍是旧代码，需人工处理"
        log "app + ingest layer deployed (rebuild)"
    else
        log "app layer unchanged"
    fi
fi

if git remote | grep -qx github; then
    git push --mirror github > /dev/null 2>&1 \
        || log "github mirror push failed (本地推送已完成)"
fi
