{
	email admin@drawcommons.org
}

drawcommons.org, www.drawcommons.org {
	encode zstd gzip

	# 访问日志：docker logs 会随容器重建丢失，落盘才可回溯与统计。
	# 保留期按时间而非仅按容量：隐私政策 3.2.4.2 / 3.5.1 写的是「不超过 30 天」，
	# 而那两处写的必须与这里一致——承诺写在文本里，兑现写在配置里。
	# roll_keep_for 设置后 roll_keep 被忽略，故只留前者（30 天 = 720h）。
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep_for 720h
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 2026-11-26 撤掉全站 noindex。11-17 加它的理由是「测试期、站点里还是结构样例」，
		# 现在协议已公示、账本有真实闭环、MCP 已发布，公开投放要求搜索结果能收到站点——
		# 保留它就等于「投放只是发链接」，而且没有第二次机会。
		# 只在下面三处保留：/sign/*（某人正在签的一单）、/welcome*（六张图，无文字）、
		# /api/*（JSON 不是内容页）。静态 15 页与 app 渲染的协议/需求页一律可收录。
		-Server
	}

	# ============ 重定向（静态兜底之前） ============
	# `/` 到引导第一屏：这一步原先是 app 做的（do_GET 里 path in ("/","/en") → 302）。
	# 人类页面换成静态后 app 不再碰 `/`，不写这条首页就是 404。
	# 用 302 不用 301：这是产品决策不是地址变更，301 会被浏览器长期缓存。
	redir / /welcome 302
	redir /en /en/welcome 302

	# 旧入口改道。301 而不是 302：这是永久搬家，让搜索引擎与外部链接自己更新。
	# `{?query}` 而不是裸路径：`/needs?state=open` 里的筛选必须跟着走。丢掉它
	# **不会报错**——屏幕上看像「筛选生效了」，实际回到了全量，比 404 更像谎话。
	# app 里原本那条 301 特意拼过查询串，换到 Caddy 不能把它丢掉。
	redir /requests /tasks{?query} 301
	redir /testing /feedback{?query} 301
	redir /join /feedback{?query} 301
	redir /needs /tasks{?query} 301

	# 公开仓库（哑协议，只读）：第三方 clone 下来自己复现，不需要任何账号。
	# 用哑协议而非 git-http-backend（Caddy 无 CGI），代价是不支持 push/PR——
	# 本仓本来也不接受外部推送，只接受邮件与 issue 反馈，够用。
	# 裸仓由 /opt/drawcommons/git/drawcommons.git 挂入（compose 内 :ro）。
	handle_path /repo.git/* {
		# 裸仓是分发通道，不是内容页：让索引里出现一堆 git 对象没有意义
		header X-Robots-Tag "noindex, nofollow"
		root * /srv/git/drawcommons.git
		file_server
	}

	# 免装 git 的复现包（含 sha256），给只想核一次字节的人
	handle_path /download/* {
		# 安装包与协议正文的下载件：可被直链引用，但不必进索引
		header X-Robots-Tag "noindex, nofollow"
		root * /srv/git/download
		file_server
	}

	# 06 的签署页（乙那侧）：单文件、无外部脚本、与站点同源直接提交。
	# 不塞进 /download——那里是「证据与复现包」，这是一个应用入口。
	# 2026-11-14 加。
	# 少写一个斜杠就 404 会让扫码的人以为坏了（catch-all 会把它交给 app）。
	redir /sign /sign/ permanent

	handle_path /sign/* {
		root * /srv/git/sign
		# 这是某个人正在签的一单，不该被搜索引擎收进去
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	# ============ 写面 / 读口（次序由匹配器具体性决定，不靠书写顺序） ============
	# 需求单发现口是**读**，所以归 app 而不是 ingest。
	# `/api/v1/*` 那条通配把整个前缀给了写入面，但 `GET /api/v1/requests` 不写库、
	# 不验签、读的是需求单而不是账目——放进写面会让「ingest 只做写」这条部署口径
	# 变模糊，而那条口径正是「公开页物理上不能写」的另一半。
	# handle 组按匹配器具体性排序，`/api/v1/requests*` 比 `/api/v1/*` 更具体，
	# 永远排在前面；`/api/v1/request`（单数，写口）不会被它吃掉，两者互不重叠。
	handle /api/v1/requests* {
		# JSON 不是内容页：收了也只会把接口原样摊到搜索结果里
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 写入面（r6）：三条受控 POST。与公开页是两个容器、两条路径。
	handle /api/v1/* {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy ingest:8001 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 账本读口（/api/ledger/items|verify|export）。2026-11-17 加：
	# 加了静态兜底之后，不显式写这段，这些接口会去 /srv/site 找文件而全部 404。
	# 比上面的 /api/v1/* 短，按具体性排序永远在后，吃不掉写面。
	handle /api/* {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# ============ app 渲染的页面 ============
	# 协议三份文本与纯文本原文：需要注入 sha256 指纹与版本串，只能 app 渲染。
	# 只放行**带斜杠的子路径**——/terms 本身已换成静态公示页，不能让这里吃掉。
	handle /terms/* {
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 欢迎三屏（一页一屏：/welcome、/welcome/2、/welcome/3 与英文同名三屏），仍是 app 渲染。
	handle /welcome* {
		# 六张图、一页一屏，没有可被检索引的文字
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 引导三屏的六张图（/images/welcome-{1,2,3}.jpg 与 -m 移动版）走 app 的白名单出件。
	# 2026-11-22 补：11-17 把 catch-all 反代换成静态兜底时，这条隐式路径一起被换掉了——
	# `/images/*` 从此落到 /srv/site（那里没有 images/），六张图连续 404 五天，
	# 每个访客进门第一屏都是破图。不改成「把图拷进 site/」：白名单、
	# Content-Type 与「表外名字一律 404」都在 app 里，拷文件等于让 URL 重新描述资源。
	handle /images/* {
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 英文引导三屏（/en/welcome、/en/welcome/2、/en/welcome/3）：只有这三条还是 app 渲染。
	# `handle /en/welcome*` 比下面那条静态兜底更具体，Caddy 的 handle 组按匹配器具体性
	# 排序，无匹配器的 `handle {}` 永远垫底——所以"更具体"不是靠书写顺序，是靠匹配器。
	# 英文站其余 14 页（/en/home、/en/terms、/en/ledger …）已出静态件，走末尾兜底。
	# 不做 `handle /en/*` 显式静态块：兜底已经是同一件事，多一条只是多一个会走偏的地方。
	handle /en/welcome* {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 需求单详情 /r/<id>：动态路径，静态目录里没有对应文件。漏了这条就是 404。
	handle /r/* {
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# 机器面三个文本件 + 健康检查。
	@machine path /agent.md /audit.md /llms.txt /healthz
	handle @machine {
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_down -Server
		}
	}

	# ============ 静态兜底（必须最后：无匹配器，永远垫底） ============
	# 15 个人类页面 + 英文 15 页（site/ 与 site/en/ → /opt/drawcommons/site/，compose 只读挂入）。
	# try_files 靠 `{path}.html` 命中：/home → /srv/site/home.html，/en/home → /srv/site/en/home.html。
	# 为什么不走 app：这批页面要跑 JS（生成密钥、签名、取单、发单），而公开页的 CSP
	# 是 `script-src 'none'`——那不是疏漏，是「公开页物理上不能写」的一半。
	# 代价：静态目录里没有的文件就是 404，没有 app 的兜底渲染。
	# 但 try_files 会兜住「文件放对就能访问」——新增页不必再加路由，放进 site/ 即可命中。
	# 真正要补的是入口：导航、/notices 卡片、en_map.json 译文，否则页面在、没人找得到。
	handle {
		root * /srv/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
