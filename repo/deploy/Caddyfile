{
    email admin@drawcommons.org
}

drawcommons.org, www.drawcommons.org {
    encode zstd gzip

    # 访问日志：docker logs 会随容器重建丢失，落盘才可回溯与统计。
    log {
        output file /data/access.log {
            roll_size 20MiB
            roll_keep 8
        }
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy app:8000 {
        # 覆写而非追加：Caddy 默认会把客户端自带的 X-Forwarded-For 追加进链条，
        # 那样客户端能伪造来源 IP，日志就不可信。这里固定成真实对端。
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # 上游 Server 头带出 Python 版本号，去掉
        header_down -Server
    }
}
